{
  "name": "proof-sdk",
  "version": "0.1.0",
  "description": "Open-source collaborative markdown editor with provenance tracking and an agent HTTP bridge",
  "private": false,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/finalize-web-build.mjs",
    "serve": "tsx server/index.ts",
    "library": "tsx server/library/cli.ts",
    "test": "npm run test:proof-sdk && npm run test:server-routes-share && npm run test:library && npm run test:soma-feedback && npm run test:client-errors && npm run test:agent-keys && npm run test:line-marks && npm run test:reading-walk && npm run test:folding && npm run test:asks && npm run test:identity && npm run test:honest && npm run test:aids && npm run test:bundles && npm run test:do && npm run test:chat && npm run test:editing-first && npm run test:orphans && npm run test:proxy && npm run test:tiers",
    "test:proof-sdk": "tsx src/tests/proof-sdk-agent-bridge-client.test.ts",
    "test:server-routes-share": "tsx src/tests/server-routes-and-share.test.ts",
    "test:client-errors": "tsx src/tests/error-sanitizer.test.ts && tsx src/tests/client-errors.test.ts",
    "test:soma-feedback": "tsx src/tests/soma-feedback.test.ts",
    "test:library": "tsx src/tests/library-cli.test.ts && tsx src/tests/library.test.ts && tsx src/tests/soma-app.test.ts",
    "demo:agent": "npm --workspace proof-example run demo:agent",
    "test:agent-keys": "tsx src/tests/agent-key-duplicate-cookies.test.ts && tsx src/tests/agent-key-session-issuance.test.ts && tsx src/tests/agent-keys.test.ts && tsx src/tests/agent-key-collab-revocation.test.ts && tsx src/tests/share-event-poller.test.ts",
    "test:line-marks": "tsx src/tests/line-marks.test.ts",
    "test:reading-walk": "tsx src/tests/reading-walk.test.ts",
    "test:editing-first": "tsx src/tests/editing-first.test.ts",
    "test:folding": "tsx src/tests/folding.test.ts",
    "test:asks": "tsx src/tests/asks.test.ts",
    "test:identity": "tsx src/tests/identity.test.ts",
    "test:honest": "tsx src/tests/honest-reading.test.ts",
    "test:aids": "tsx src/tests/review-aids.test.ts",
    "test:bundles": "tsx src/tests/bundles-alts.test.ts",
    "test:do": "tsx src/tests/do.test.ts",
    "test:orphans": "tsx src/tests/orphaned-suggestion-marks.test.ts",
    "test:agent-key-dialog": "tsx src/tests/agent-key-dialog.browser.test.ts",
    "test:chat": "tsx src/tests/chat.test.ts",
    "test:proxy": "tsx src/tests/proxy-marks.test.ts",
    "test:tiers": "tsx src/tests/line-tiers.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@handlewithcare/prosemirror-suggest-changes": "^0.1.8",
    "@hocuspocus/provider": "^2.15.2",
    "@hocuspocus/server": "^2.15.2",
    "@milkdown/core": "^7.5.0",
    "@milkdown/kit": "^7.5.0",
    "@milkdown/plugin-clipboard": "^7.5.0",
    "@milkdown/plugin-collab": "^7.18.0",
    "@milkdown/plugin-cursor": "^7.5.0",
    "@milkdown/plugin-history": "^7.5.0",
    "@milkdown/plugin-listener": "^7.5.0",
    "@milkdown/plugin-prism": "^7.18.0",
    "@milkdown/preset-commonmark": "^7.5.0",
    "@milkdown/preset-gfm": "^7.5.0",
    "@milkdown/theme-nord": "^7.5.0",
    "@resvg/resvg-js": "^2.6.2",
    "beautiful-mermaid": "^1.1.3",
    "better-sqlite3": "^12.6.2",
    "express": "^5.2.1",
    "prismjs": "^1.30.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "satori": "^0.24.1",
    "web-haptics": "^0.0.6",
    "wink-eng-lite-web-model": "^1.2.1",
    "wink-nlp": "^2.1.0",
    "ws": "^8.19.0",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.2.19",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.20",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.0",
    "@types/prismjs": "^1.26.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "playwright": "1.63.0"
  }
}
